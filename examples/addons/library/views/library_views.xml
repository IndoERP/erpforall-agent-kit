<?xml version="1.0" encoding="utf-8"?>
<erp>
    <record id="library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Books">
                <field name="name"/>
                <field name="author_id"/>
                <field name="genre_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="author_id"/>
                        <field name="genre_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page name="description" string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <aside>
                    <group string="Record information">
                        <field name="create_uid" readonly="1"/>
                        <field name="create_date" readonly="1"/>
                        <field name="write_uid" readonly="1"/>
                        <field name="write_date" readonly="1"/>
                    </group>
                </aside>
            </form>
        </field>
    </record>
    <record id="library_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="author_id"/>
                <field name="genre_ids"/>
            </search>
        </field>
    </record>
    <record id="library_author_list" model="ir.ui.view">
        <field name="name">library.author.list</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <list string="Authors">
                <field name="name"/>
                <field name="country"/>
            </list>
        </field>
    </record>
    <record id="library_author_form" model="ir.ui.view">
        <field name="name">library.author.form</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <form string="Author">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="country"/>
                    </group>
                    <notebook>
                        <page name="books" string="Books">
                            <field name="book_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <aside>
                    <group string="Record information">
                        <field name="create_uid" readonly="1"/>
                        <field name="create_date" readonly="1"/>
                        <field name="write_uid" readonly="1"/>
                        <field name="write_date" readonly="1"/>
                    </group>
                </aside>
            </form>
        </field>
    </record>
    <record id="library_book_action" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="library_book_search"/>
    </record>
    <record id="library_author_action" model="ir.actions.act_window">
        <field name="name">Authors</field>
        <field name="res_model">library.author</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="library_menu" name="Library" groups="base.group_user" sequence="70" web_icon="lucide:library">
        <menuitem id="library_book_menu" name="Books" action="library_book_action" sequence="10"/>
        <menuitem id="library_author_menu" name="Authors" action="library_author_action" sequence="20"/>
    </menuitem>
</erp>
